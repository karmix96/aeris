# Governed S6 qualification figures are small, hash-bound evidence.
!AERIS_MESH_STUDY/05_s6_cfd_qualification/reports/*.png

# Secrets and Windows/WSL download metadata — never commit
github_token.txt
*:Zone.Identifier

# ML runtime artifacts
catboost_info/

# Local patch/operator scripts
*.sh
.vsptime
*.bak_*

# Generated study artifacts (1+ GB: meshes, STEP/STL, surface samples, HTML previews).
# Rescue any REPORT.md / findings into configs/ BEFORE wiping — see MEMORY policy.
artifacts/

# Reference papers / strategy docs kept locally, not versioned
*.pdf
!AERIS_MESH_STUDY/05_s6_cfd_qualification/reports/*.pdf

# Stray solver history (bare SU2/ADflow header, no data)
history.csv

# AERIS mesh study: downloaded third-party binaries and reference papers.
# tools/ holds the SU2 8.5.0 prebuilt release (165 MB) and papers/ the reference
# PDFs (206 MB); both are reproducible downloads, not project source.
AERIS_MESH_STUDY/tools/
AERIS_MESH_STUDY/papers/

# ParaView mesh artifacts - regenerated, and wiped between campaigns
data/surface_mesh_v3/

# S6 qualification run records are versioned, but generated mesh payloads are
# local-only. Their hashes and small independent audit reports remain tracked.
AERIS_MESH_STUDY/05_s6_cfd_qualification/studies/**/*.cgns
AERIS_MESH_STUDY/05_s6_cfd_qualification/studies/**/*.fmt
AERIS_MESH_STUDY/05_s6_cfd_qualification/studies/**/*.npz

# One-shot S6 CFD canaries retain their complete local solver package and fields;
# only small hash-bound execution summaries under reports/ are versioned.
AERIS_MESH_STUDY/05_s6_cfd_qualification/studies/canary/
