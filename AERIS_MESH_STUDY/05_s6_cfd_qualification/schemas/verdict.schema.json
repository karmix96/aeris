{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeris.s6.verdict.v1",
  "type": "object",
  "required": ["schema_version", "execution_id", "policy_id", "classification", "residuals", "mass_imbalance_normalized"],
  "properties": {
    "schema_version": {"const": 1},
    "execution_id": {"type": "string"},
    "policy_id": {"type": "string"},
    "classification": {"enum": ["PASS", "FAIL", "BLOCKED", "INCONCLUSIVE"]},
    "residuals": {"type": "object", "required": ["density", "momentum", "energy", "sa"]},
    "mass_imbalance_normalized": {"type": "number", "minimum": 0}
  }
}
